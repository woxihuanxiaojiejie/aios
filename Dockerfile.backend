FROM ghcr.io/astral-sh/uv:python3.12-bookworm

WORKDIR /app
ENV UV_NO_SYNC=1

COPY pyproject.toml uv.lock README.md ./
COPY alembic.ini ./
COPY alembic ./alembic
COPY src ./src

RUN uv sync --extra llm --extra market-data-baostock --no-dev

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "aios.api.app:create_default_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
