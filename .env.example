# Real external LLM smoke. Use a provider-prefixed LiteLLM model, for example:
# AIOS_EXTERNAL_LLM_MODEL=deepseek/deepseek-chat
# AIOS_EXTERNAL_LLM_MODEL=openai/gpt-4o-mini
AIOS_EXTERNAL_LLM_MODEL=

# PostgreSQL storage used by the API and Docker Compose.
AIOS_DATABASE_URL=postgresql+psycopg://aios:aios@localhost:5432/aios

# Provider key matching AIOS_EXTERNAL_LLM_MODEL. Do not commit real keys.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Optional provider base URL override. Leave empty to use adapter defaults.
DEEPSEEK_API_BASE=
OPENAI_API_BASE=

# Browser code calls only the AIOS backend. Never put provider API keys here.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
AIOS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

AIOS_RUN_EXTERNAL_LLM_TESTS=0
